<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '20px 60px' }}>
  <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center' }}>
    <Box style={{ width: 6, height: 44, background: '#3B82F6', borderRadius: 3, marginRight: 16 }} />
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>全自动模式：让它自己跑</Text>
      <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: 4 }}>第一章 · 核心更新能力</Text>
    </Box>
  </Box>
  <Box style={{ height: 508, gap: 22, flexDirection: 'row' }}>
    {[
      ['clock', '定时自动检查', '#3B82F6', [
        ['自动检查间隔', '15–1440 分钟可调，后台静默执行 git fetch 比对远端提交数，发现落后立即记录并提醒'],
        ['Gateway 监视', '每 5 分钟探测网关运行状态，掉线/恢复即时提醒，状态翻转才通知不重复骚扰'],
        ['启动即检查', '打开工具首屏 1–2 秒先展示版本与网关快照，网络探测后台并行不阻塞界面'],
      ]],
      ['play-circle', '自动执行 + 时间护栏', '#F59E0B', [
        ['倒计时确认', '发现新版本先弹横幅倒计时，可立即更新或跳过本次，也可设 0 秒全自动直更'],
        ['免打扰时段', '设定 HH:MM~HH:MM 时间段（支持跨午夜），时段内自动检查静默跳过，手动更新不受限'],
        ['稍后提醒', '仪表盘一键「稍后 1/3/6 小时」抑制新版本提醒与自动执行，随时可取消'],
      ]],
      ['chart-bar', '历史与统计', '#06B6D4', [
        ['更新热力图', 'GitHub 风格 12 周 × 7 天活跃格子，颜色深浅代表当天更新次数，悬停显示日期明细'],
        ['多维统计', '本月成功/失败计数、近 7 天周报、下次自动检查倒计时实时展示'],
        ['完整历史', '每次更新记录时间、结果、触发方式、耗时、提交前后哈希与失败原因，支持 CSV 导出'],
      ]],
    ].map(([ic, title, color, items]) => (
      <Box key={title} style={{ flex: 1, background: '#F8FAFC', borderRadius: 16, padding: '24px 22px', borderTop: `4px solid ${color}`, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 16 }}>
          <Box style={{ width: 48, height: 48, borderRadius: 12, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center', boxShadow: '0 2px 10px rgba(15,23,42,0.08)' }}>
            <FAIcon name={ic} style={{ fill: color, width: 26, height: 26 }} />
          </Box>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F172A' }}>{title}</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 14 }}>
          {items.map(([t, d]) => (
            <Box key={t}>
              <Text style={{ fontSize: 15.5, fontWeight: 'bold', color: '#0F172A' }}>{t}</Text>
              <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.55, marginTop: 3 }}>{d}</Text>
            </Box>
          ))}
        </Box>
      </Box>
    ))}
  </Box>
  <Box style={{ height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>HermesUpdater · 功能全景</Text>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>05 / 19</Text>
  </Box>
</Slide>
